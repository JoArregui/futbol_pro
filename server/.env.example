# SQLite - el backend ya no requiere MySQL. Solo PORT es necesario.
# Mantener DB_* por compatibilidad si migras de vuelta a MySQL.
PORT=3000
SQLITE_PATH=./futbol_pro.db

# Auth JWT + superadmin seed (NUNCA commitear el .env real)
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
# Access corto (rotación con refresh). Ej: 15m
JWT_EXPIRES_IN=15m
# Refresh largo. Días como número:
JWT_REFRESH_DAYS=30
JWT_REFRESH_EXPIRES_IN=30d
SUPERADMIN_EMAIL=admin@futbolpro.com
SUPERADMIN_PASSWORD=Admin123!
SUPERADMIN_NAME=SuperAdmin
# CORS: orígenes web permitidos, separados por coma. Vacío = solo localhost.
FRONTEND_ORIGIN=http://localhost:8080
# Economía de reservas: fracción de seña (0.2 = 20%).
SENA_PCT=0.2

# PayPal REST Orders v2. Usa sandbox para pruebas y live en producción.
PAYPAL_CLIENT_ID=tu_client_id
PAYPAL_CLIENT_SECRET=tu_client_secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CURRENCY=EUR

# Legacy MySQL (ignorado en modo SQLite)
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=tu_password_seguro
# DB_NAME=futbol_pro
# DB_PORT=3306
# DB_CONNECTION_LIMIT=10
